{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "java",
      "runtimeArgs": [
        "-jar",
        "backend/target/anticorruption-0.0.1-SNAPSHOT.jar",
        "--app.storage.location=backend/uploads",
        "--spring.config.additional-location=optional:file:backend/src/main/resources/application-local.properties"
      ],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    }
  ]
}
